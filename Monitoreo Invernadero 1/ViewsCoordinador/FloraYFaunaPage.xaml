<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Monitoreo_Invernadero_1.ViewsCoordinador.FloraYFaunaPage"
             Title="FloraYFaunaPage"
             NavigationPage.HasNavigationBar="False">
    <ScrollView>

        <Grid RowDefinitions=".9*,.2*" RowSpacing="-70" >

            <Grid Grid.Row="0" Padding="0" HorizontalOptions="Center" VerticalOptions="Center">
            <!-- Scrollable content -->
            <VerticalStackLayout Spacing="15" 
                                  Padding="25,30,25,30">
                    
                    <Grid RowDefinitions="*,*,*" ColumnDefinitions="*" VerticalOptions="Center" HorizontalOptions="Center" ColumnSpacing="20" RowSpacing="30" Padding="0">

                        <Grid Grid.Row="0">
                            <Label Text="Flora y Fauna"
                               TextColor="#16162E"
                               FontFamily="OswaldB"
                               FontAttributes="Bold"
                               FontSize="40"
                               HorizontalOptions="Center"/>
                        </Grid>

                    <!-- BOTON 1 FLORA  -->
                    <Frame Grid.Row="1" Grid.Column="0" Padding="40" HasShadow="True" WidthRequest="260">
                        <Grid VerticalOptions="Center" HorizontalOptions="Center" >
                            <Button BackgroundColor="White"
                                     Clicked="OnFlora_Clicked"
                                     x:Name="OnFlora"/>
                            <Grid  RowDefinitions="*,*,*" ColumnDefinitions="*" Grid.Row="1" Grid.Column="1" >
                                <Image Source="flora.png" Grid.Row="0" HeightRequest="60"/>
                                <Label Text="Flora" Grid.Row="1" FontAttributes="Bold" FontSize="20" HorizontalOptions="Center"/>
                            </Grid>

                        </Grid>
                    </Frame>

                    <!-- BOTON 2 FAUNA -->
                    <Frame Grid.Row="2" Grid.Column="0" Padding="40" HasShadow="True">
                        <Grid VerticalOptions="Center" HorizontalOptions="Center" >
                            <Button BackgroundColor="White" 
                                     x:Name="OnFauna"
                                     Clicked="OnFauna_Clicked"/>
                            <Grid  RowDefinitions="*,*,*" ColumnDefinitions="*" Grid.Row="1" Grid.Column="1" >
                                <Image Source="fauna.png" Grid.Row="0" HeightRequest="60"/>
                                    <Label Text="Fauna" Grid.Row="1" FontAttributes="Bold" FontSize="20" HorizontalOptions="Center"/>
                            </Grid>

                        </Grid>
                    </Frame>

                </Grid>
            </VerticalStackLayout>

        </Grid>
        <Grid VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="260" Grid.Row="2">
            <Button Text="Menú"
                 BackgroundColor="#16162E"
                 FontAttributes="Bold"
                 FontFamily="Roboto"
                 x:Name="OnMenu"
                 Clicked="OnMenu_Clicked"/>
        </Grid>

    </Grid>
    </ScrollView>
</ContentPage>